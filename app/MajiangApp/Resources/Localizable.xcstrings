    "一场只用一套规则，改了以后前面的局一起重算。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一场只用一套规则，改了以后前面的局一起重算。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つの対局には共通ルールが適用され、変更すると過去の局も再計算されます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One rule set applies to the whole game; changing rules recalculates prior hands."
          }
        }
      }
    },
