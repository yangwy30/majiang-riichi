    "%@ 超过了 4 张，一定有牌认错了。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 超过了 4 张，一定有牌认错了。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が5枚以上あります。誤認識の牌をタップして直してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than 4 copies of %@; tap the misread tile to fix it."
          }
        }
      }
    },
    "%@和错了？": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@和错了？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のチョンボ（錯和）？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chombo by %@?"
          }
        }
      }
    },
    "%@点的炮。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@点的炮。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の放銃。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dealt in by %@."
          }
        }
      }
    },
    "%@的番数不够新的起和，先照样算着；要删可以在账本里点那一局。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@的番数不够新的起和，先照样算着；要删可以在账本里点那一局。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は新しい縛りに届いていませんが、そのまま計算しています。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is below the new minimum han; kept as-is unless deleted from the ledger."
          }
        }
      }
    },
